{
  "extends": ["html-validate:document"],
  "rules": {
    "doctype-first": "error",
    "require-lang": "error",
    "require-meta-charset": "error",
    "require-meta-viewport": "error",
    "void-style": "error",
    "attr-name-style": "off",
    "element-attr-lowercase": "error",
    "id-class-value": "off",
    "class-name-style": "off",
    "element-heading-order": "error",
    "require-heading-content": "error",
    "require-hr": "off",
    "attr-duplicate": "error",
    "attr-value-not-space-separated": "off",
    "require-button-type": "error",
    "no-obsolete-elements": "error",
    "require-lang-on-html": "error",
    "require-meta-http-equiv-content-language": "off",
    "style-disallowed": "off",
    "anchor-has-content": "off",
    "void-elements": "error",
    "tabindex-no-positive": "error",
    "aria-valid-attr-value": "error",
    "aria-required-attr": "error",
    "aria-required-children": "error",
    "aria-required-parent": "error",
    "aria-valid-role": "error",
    "aria-valid-attr": "error",
    "button-type": "error",
    "id-unique": "error",
    "img-alt-require": "error",
    "label-no-label": "error",
    "input-missing-name": "error",
    "no-layout-tables": "error",
    "element-permitted-content": "error",
    "no-duplicate-id": "error"
  }
}
